# SRS configuration for Cosmo device deployment.
# @see full.conf for all available options.

listen              1936;
max_connections     1000;
daemon              on;
pid                 @COSMO_DATA_DIR@/log/logs/srs.pid;
srs_log_tank        file;
srs_log_file        @COSMO_DATA_DIR@/log/logs/srs.log;

http_api {
    enabled         on;
    listen          1985;
}
http_server {
    enabled         on;
    listen          18088;
    dir             ./objs/nginx/html;
}
rtc_server {
    enabled on;
    listen 8000;
    candidate *;
}
stream_caster {
    # Media allocation is controlled locally by CosmoEdge. No SIP auto-registration.
    enabled on;
    caster gb28181;
    output rtmp://127.0.0.1:1936/live/[stream];
    listen @COSMO_GB28181_MEDIA_PORT@;
    sip {
        enabled off;
        listen @COSMO_GB28181_SIP_PORT@;
        candidate @COSMO_GB28181_CANDIDATE@;
    }
}

vhost __defaultVhost__ {
    hls {
        enabled     on;
    }
    http_remux {
        enabled     on;
        mount       [vhost]/[app]/[stream].flv;
    }
    rtc {
        enabled     on;
        rtmp_to_rtc on;
        rtc_to_rtmp on;
    }
    play {
        gop_cache_max_frames 2500;
    }
}
