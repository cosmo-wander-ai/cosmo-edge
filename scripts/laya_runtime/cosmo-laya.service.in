[Unit]
Description=CosmoEdge Laya helmet review worker
After=local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/data/cosmo-laya/current/runtime.env
ExecStart=/usr/bin/python3 /data/cosmo-laya/current/managed_worker.py --manifest /data/cosmo-laya/current/manifest.json --manifest-sha256 ${LAYA_MANIFEST_SHA256}
RuntimeDirectory=cosmo-laya
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=10
WatchdogSec=20
KillMode=control-group
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
