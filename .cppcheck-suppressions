// Exclude third-party and generated sources.
*:*3rd/*
*:*build/*
*:*test/catch_amalgamated.*
*:*test/trompeloeil.hpp

// Host analysis lacks cross-compilation system headers. Partial scans also
// intentionally leave rules for files outside the selected scope unmatched.
missingIncludeSystem
unmatchedSuppression

// Standalone header scans cannot see field uses in other translation units,
// including DTO serializers.
unusedStructMember:*.h

// Preserve supported implicit conversions and public by-value/reference APIs.
// Changing these signatures or adding explicit would break existing callers.
noExplicitConstructor:*src/flow/common/AlgAlarmTypes.h:85

// Retired instances must be destroyed after the pool lock is released.
// The reservation destructor reads active; clearing it prevents a second decrement.
variableScope:*src/util/InstancePool.h:133
redundantAssignment:*src/util/InstancePool.h:175
unreadVariable:*src/util/InstancePool.h:175

// Each overlay pass rechecks detection state after the preceding drawing calls.
duplicateCondition:*src/flow/task/PTaskBaseUpload.cc:223

// Construct a device only for a missing key; eager insertion arguments would
// create and destroy extra device instances and change constructor side effects.
stlFindInsert:*src/nn/core/abstract_device.h:49

// Existing concrete APIs intentionally hide non-virtual base names. Preserve
// their by-value return types and concrete state instead of silently routing
// callers to AlgActionBase's action-node metadata (or changing public types).
duplInheritedMember:*src/flow/alarm/TaskFaceAlarm.h:46
duplInheritedMember:*src/flow/detect/AiDetector.h:93
duplInheritedMember:*src/flow/alarm/AreaAlarm.h:139
duplInheritedMember:*src/flow/track/AiTracker.h:63

// These concrete managers deliberately specialize placement/construction.
// AiDetectMng uses FPS-aware placement; AiLandmarkMng constructs landmark
// instances with its task/action key. Base dispatch would change behavior.
duplInheritedMember:*src/flow/detect/AiDetectMng.h:17
duplInheritedMember:*src/flow/landmark/AiLandmarkMng.h:16
