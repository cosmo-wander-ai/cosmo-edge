{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AX650N short-run capacity observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "platform", "scope", "input", "models", "series", "observations"],
  "properties": {
    "$schema": { "const": "short-capacity.schema.json" },
    "schemaVersion": { "const": 1 },
    "platform": { "const": "AX650N" },
    "scope": { "const": "short-run fixed-profile benchmark" },
    "input": { "type": "object", "required": ["repositoryPath", "sha256", "referenceV11Sha256", "codec", "width", "height", "sourceFps", "mode"] },
    "models": { "type": "object", "required": ["personSha256", "helmetSha256"] },
    "series": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "description"] } },
    "observations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "series", "workload", "targetFps", "channels", "plannedHoldSeconds", "sampleSpanSeconds", "result", "minimumNodeFps", "reason", "sourceSha256", "sourceMetricsSha256", "sourceAuditSha256", "cpuPeakPercent", "memoryPeakPercent", "acceleratorPeakPercent", "diskPeakPercent", "decodeDiscardDelta", "classifierForwardSuccessDelta"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "series": { "type": "string", "minLength": 1 },
          "workload": { "enum": ["person", "helmet", "mixed"] },
          "targetFps": { "type": "number", "exclusiveMinimum": 0 },
          "channels": { "type": "integer", "minimum": 1 },
          "plannedHoldSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "sampleSpanSeconds": { "type": ["number", "null"], "minimum": 0 },
          "result": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
          "minimumNodeFps": { "type": ["number", "null"], "minimum": 0 },
          "reason": { "type": ["string", "null"] },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceMetricsSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "sourceAuditSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "cpuPeakPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "memoryPeakPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "acceleratorPeakPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "diskPeakPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "decodeDiscardDelta": { "type": ["integer", "null"], "minimum": 0 },
          "classifierForwardSuccessDelta": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
