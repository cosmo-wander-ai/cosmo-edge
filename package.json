{
  "name": "cosmo-edge-docs",
  "private": true,
  "description": "CosmoEdge documentation site for the open-source C++ edge AI engine.",
  "homepage": "https://www.cosmowander.ai/docs/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cosmo-wander-ai/cosmo-edge.git"
  },
  "bugs": {
    "url": "https://github.com/cosmo-wander-ai/cosmo-edge/issues"
  },
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/copy-static-benchmark-assets.mjs && node scripts/generate-v1.1-benchmark-pages.mjs",
    "docs:preview": "vitepress preview docs",
    "gitee:readme:generate": "node scripts/generate-gitee-readme.mjs",
    "gitee:readme:check": "node scripts/generate-gitee-readme.mjs --check",
    "docs:check": "node scripts/check-tutorial-docs.mjs",
    "docs:smoke": "node scripts/smoke-tutorial-pages.mjs",
    "benchmarks:v1.1:smoke": "node scripts/smoke-benchmark-pages.mjs",
    "benchmarks:v1.1:generate": "node scripts/generate-v1.1-benchmark-pages.mjs",
    "benchmarks:v1.1:checksums": "node scripts/generate-v1.1-benchmark-pages.mjs --write-source-checksums",
    "benchmarks:v1.1:verify-vlm-private": "node scripts/verify-v1.1-vlm-private.mjs",
    "benchmarks:v1.1:validate": "node scripts/validate-public-v1.1-multistream-benchmark.mjs",
    "docs:verify": "npm run gitee:readme:check && npm run benchmarks:v1.1:validate -- --source-only && npm run docs:check && npm run docs:build && npm run docs:smoke && npm run benchmarks:v1.1:smoke",
    "docs:contracts": "node scripts/test-tutorial-contracts.mjs && node scripts/test-benchmark-validation.mjs",
    "config:check": "node scripts/check-build-contracts.mjs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
