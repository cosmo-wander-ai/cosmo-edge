{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cosmo-wander-ai/cosmo-edge/test/agent/schemas/task-contract-v1.schema.json",
  "title": "CosmoEdge task contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "task",
    "userObjective",
    "expectedDeliverables",
    "allowedChanges",
    "requiredCapabilities",
    "acceptance",
    "authority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "userObjective": {
      "type": "string",
      "minLength": 1
    },
    "expectedDeliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": true
          }
        ]
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": [
        "workspace"
      ],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "grants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "environment-change",
              "remote-execution",
              "model-transfer",
              "device-deployment"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "parameters": {
      "type": "object",
      "properties": {
        "quantizeTable": {
          "type": "string",
          "minLength": 1,
          "description": "Sophon mixed-precision table file within the current private run."
        },
        "calibrationTable": {
          "type": "string",
          "minLength": 1,
          "description": "Sophon calibration table file within the current private run; required for INT8 conversion."
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
